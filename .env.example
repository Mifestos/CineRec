# ==========================================
# Database Credentials (используются Docker Compose)
# ==========================================
POSTGRES_USER=cinerec_user
POSTGRES_PASSWORD=cinerec_password
POSTGRES_DB=cinerec_db

# ==========================================
# Application Connection Strings
# ==========================================
# Хост 'db' и 'redis' работают внутри Docker-сети.
# Для локального запуска без Docker замените на 'localhost'.
DATABASE_URL=postgresql://cinerec_user:cinerec_password@db:5432/cinerec_db
REDIS_URL=redis://redis:6379/0

# ==========================================
# Security
# ==========================================
# Сгенерируйте свой ключ командой: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_64_character_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30